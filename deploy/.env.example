# Contract Reviewer Plus Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/contract_db
REDIS_URL=redis://localhost:6379/0

# ONLYOFFICE Document Server
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
ONLYOFFICE_SECRET=contract_reviewer_secret_jwt

# Storage
STORAGE_DIR=./data/storage

# AI Gateway
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MOCK_AI_PIPELINE=true

# Execution Limits
MAX_REVIEW_RETRIES=3
REVIEW_DEADLINE_SECONDS=180
WORKER_LEASE_SECONDS=60

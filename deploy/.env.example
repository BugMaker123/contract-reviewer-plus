# Contract Reviewer Plus Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/contract_db
REDIS_URL=redis://localhost:6379/0

# ONLYOFFICE Document Server
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
ONLYOFFICE_SECRET=contract_reviewer_secret_jwt

# Storage
STORAGE_DIR=./data/storage

# AI Gateway & Domestic Models (支持 DeepSeek / 阿里百炼通义千问 / OpenAI / 硅基流动)
LLM_PROVIDER=deepseek

# DeepSeek Configuration (推荐: deepseek-v4-flash, deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen (通义千问 / DashScope)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# OpenAI / Standard Gateway
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 离线模拟开关 (当未配置 API_KEY 时自动启用高拟真专业法务离线降级引擎)
MOCK_AI_PIPELINE=false

# Execution Limits
MAX_REVIEW_RETRIES=3
REVIEW_DEADLINE_SECONDS=180
WORKER_LEASE_SECONDS=60

